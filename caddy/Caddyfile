{
	# On-demand TLS: a certificate is issued the first time a request arrives for a host,
	# but only after Caddy asks the app whether that host is a known, active tenant.
	# This is what makes "add a client = point their domain at us" work with no redeploy.
	on_demand_tls {
		ask http://app:3000/api/tls/allow
		interval 2m
		burst 5
	}
	email {$ACME_EMAIL}
}

# Every tenant domain is served by the same app; the app resolves the tenant from the Host
# header. https:// with no host matcher means "any host", gated by on-demand TLS above.
https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}
