#!/bin/bash
# Security: Pre-commit hook to detect secrets before commit
# This hook prevents committing hardcoded secrets, API keys, and database URLs

set -e

# Color output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check for secrets in staged files
SECRETS_FOUND=0

# Patterns to detect
PATTERNS=(
  # Database URLs and connection strings
  'DATABASE_URL.*=.*postgres'
  'postgres.*://.*:.*@'
  'mysql.*://.*:.*@'
  'mongodb.*://.*:.*@'

  # API Keys and tokens
  'API_KEY.*=.*[A-Za-z0-9_-]{20,}'
  'APIKEY.*=.*[A-Za-z0-9_-]{20,}'
  'SECRET.*=.*[A-Za-z0-9_-]{20,}'
  'TOKEN.*=.*[A-Za-z0-9_-]{20,}'
  'METAAPI.*=.*[A-Za-z0-9_-]{20,}'

  # AWS credentials
  'AKIA[0-9A-Z]{16}'
  'aws_secret_access_key.*=.*[A-Za-z0-9/+=]{40}'

  # JWT tokens (longer than 100 chars with dots)
  'Bearer.*[A-Za-z0-9_.-]{50,}'

  # Private keys
  '-----BEGIN PRIVATE KEY-----'
  '-----BEGIN RSA PRIVATE KEY-----'
  '-----BEGIN OPENSSH PRIVATE KEY-----'

  # Session secrets (base64, 40+ chars)
  'SESSION_SECRET.*=.*[A-Za-z0-9+/]{40,}'

  # Encryption keys
  'ENCRYPTION_KEY.*=.*[A-Za-z0-9+/]{40,}'

  # SMTP passwords
  'SMTP_PASS.*=.*[^=]'
  'SMTP_PASSWORD.*=.*[^=]'
)

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

echo "Scanning staged files for secrets..."

for FILE in $STAGED_FILES; do
  # Skip certain paths
  if [[ "$FILE" == "node_modules/"* ]] || [[ "$FILE" == ".next/"* ]] || [[ "$FILE" == ".git/"* ]]; then
    continue
  fi

  # Skip .env files in .git (they shouldn't be staged anyway)
  if [[ "$FILE" == ".env"* ]] && ! git check-ignore -q "$FILE" 2>/dev/null; then
    if [[ "$FILE" == ".env" ]] && [[ -f "$FILE" ]]; then
      echo -e "${RED}✗ FAIL: .env file detected in staging area${NC}"
      echo "  Never commit .env files. Use .env.example instead."
      SECRETS_FOUND=1
      continue
    fi
  fi

  # Get staged content
  STAGED_CONTENT=$(git show ":$FILE" 2>/dev/null || echo "")

  if [ -z "$STAGED_CONTENT" ]; then
    continue
  fi

  # Check each pattern
  for PATTERN in "${PATTERNS[@]}"; do
    if echo "$STAGED_CONTENT" | grep -P "$PATTERN" >/dev/null 2>&1; then
      echo -e "${RED}✗ FAIL: Potential secret detected in $FILE${NC}"
      echo "  Pattern: $PATTERN"
      SECRETS_FOUND=1
    fi
  done
done

if [ $SECRETS_FOUND -eq 1 ]; then
  echo ""
  echo -e "${RED}Security check failed!${NC}"
  echo ""
  echo "Secrets were detected in your staged changes. Please:"
  echo "1. Remove the secret from the file"
  echo "2. Use environment variables or .env.example for configuration"
  echo "3. Stage the corrected file"
  echo "4. Retry the commit"
  echo ""
  echo "If this is a false positive, add an exception in .husky/pre-commit"
  exit 1
fi

echo -e "${YELLOW}✓ No secrets detected${NC}"
exit 0
