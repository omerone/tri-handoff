// TRi — data model
//
// Multi-tenancy: one row in `tenants` per paying client, one `users` row per tenant
// (SPEC §2: "משתמש יחיד בכל דומיין"). Every row that carries user data hangs off `users`,
// which is why `user_id` is the scoping key on the leaf tables and `tenant_id` is unique
// on `users`. The repositories in src/lib/db resolve tenant → user once and then scope
// every query by `user_id`; nothing outside that directory is allowed to touch Prisma.
//
// Money and prices are `Decimal` in the database so nothing is lost on the way in. The
// repositories convert to `number` at the boundary, because the analytics engine is pure
// arithmetic over JS numbers and the magnitudes involved (retail trading account P&L) are
// far inside the safe-integer range.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  /// Fully-qualified host, lowercased, no scheme and no trailing dot.
  /// The middleware matches the incoming Host header against this exactly.
  domain    String       @unique
  status    TenantStatus @default(active)
  notes     String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User?

  @@index([status])
  @@map("tenants")
}

enum Locale {
  he
  en
}

/// SPEC §1.1 asks for a light mode alongside the dark default. `system` follows the
/// operating system, which is resolved in CSS rather than JavaScript so there is no flash
/// of the wrong theme on first paint.
enum Theme {
  dark
  light
  system
}

/// Which of the three visual languages the interface is drawn in. A separate axis from
/// `Theme` on purpose: theme is light-or-dark and changes with the room, style is settled
/// once. Every style is drawn in both themes — see `src/lib/display-style.ts`.
enum DisplayStyle {
  depth
  instrument
  calm
}

model User {
  id       String @id @default(cuid())
  /// Unique: one trader per tenant domain.
  tenantId String @unique @map("tenant_id")

  email           String
  passwordHash    String @map("password_hash")
  locale          Locale @default(he)
  /// ISO-4217 code the UI renders figures in. Trading data arrives in the MT5 account
  /// currency and finance data in ILS; both are converted for display.
  displayCurrency String @default("ILS") @map("display_currency")
  theme           Theme  @default(dark)
  displayStyle    DisplayStyle @default(depth) @map("display_style")
  /// The dashboard arrangement the user built (SPEC §1.1). An ordered `[{id, span}]` list;
  /// null means "never touched it, use the default". Read through `normalizeLayout`, which
  /// tolerates any shape — this column outlives the code that wrote it.
  dashboardLayout Json?  @map("dashboard_layout")

  /// Whether signing in should pull from the broker on its own.
  ///
  /// SPEC §3.3 asked for a sync on every login, and that is what this used to do
  /// unconditionally. A metered provider turns it into a bill the trader never asked for: a
  /// week of checking the dashboard twice a day is fourteen syncs nobody pressed a button
  /// for, each one a broker round trip plus a symbol-spec and candle fetch.
  ///
  /// Off by default, so the refresh button in the header is the only thing that spends money
  /// unless someone deliberately turns this back on. Defaulting the other way would mean the
  /// saving arrives only for people who go looking for a setting.
  autoSyncOnLogin Boolean @default(false) @map("auto_sync_on_login")

  /// TOTP shared secret, encrypted with ENCRYPTION_KEY like the MT5 investor password.
  /// Present but unconfirmed while someone is part-way through setting 2FA up; the pair
  /// (secret, confirmedAt) is what distinguishes "abandoned the wizard" from "2FA is on".
  totpSecret        String?   @map("totp_secret")
  /// When the first correct code was entered. NULL means 2FA is off, whatever the secret says.
  totpConfirmedAt   DateTime? @map("totp_confirmed_at")
  /// The last time step a code was accepted for. Every code at or below it is refused, which
  /// is what makes a code single-use rather than valid for its whole ninety-second window.
  /// See `verifyTotp`. An Int holds a 30-second step until the year 4000.
  totpLastStep      Int?      @map("totp_last_step")
  /// SHA-256 of each *unused* recovery code. A code is spent by dropping its hash, so the
  /// length of this array is also how many are left — there is no second column to disagree
  /// with it. Empty when 2FA is off.
  totpRecoveryCodes String[]  @default([]) @map("totp_recovery_codes")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  totpChallenges TwoFactorChallenge[]
  mt5Accounts    Mt5Account[]
  trades         Trade[]
  financeEntries FinanceEntry[]
  budgets        Budget[]
  longPositions  LongPosition[]
  learning       LearningEntry[]
  syncLogs       SyncLog[]
  snapshots      AccountSnapshot[]

  @@unique([tenantId, email])
  @@map("users")
}

model Session {
  id String @id @default(cuid())

  userId     String   @map("user_id")
  /// SHA-256 of the cookie value. The raw token never touches the database, so a dump
  /// of this table cannot be replayed as a login.
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/**
 * The gap between "the password was right" and "the second factor was right".
 * A row here, rather than a signed cookie carrying the user id, for the same reason sessions
 * are rows: it can be revoked, it can be counted, and the thing in the browser is an opaque
 * token that means nothing on its own. It also gives the attempt counter somewhere to live —
 * a six-digit code is guessable in a million tries, so the challenge has to die long before
 * anyone gets near that, and a cookie cannot count its own failures.
 * Deliberately *not* a session with a flag. A half-authenticated session that `getSession`
 * had to remember to reject is one forgotten check away from being a whole one.
 */
model TwoFactorChallenge {
  id String @id @default(cuid())

  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  /// Wrong codes so far. The challenge is destroyed on the last one rather than locked, so a
  /// failed run costs the password again and cannot be ground at.
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions SuperAdminSession[]

  @@map("super_admins")
}

model SuperAdminSession {
  id String @id @default(cuid())

  superAdminId String   @map("super_admin_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@map("super_admin_sessions")
}

// ---------------------------------------------------------------------------
// MT5
// ---------------------------------------------------------------------------

enum Mt5Status {
  /// Credentials stored, never successfully verified yet.
  pending
  connected
  /// Last sync failed; see the newest SyncLog row for the reason.
  error
  disconnected
}

model Mt5Account {
  id String @id @default(cuid())

  userId String @map("user_id")

  login  String
  server String

  /// What the trader calls this account — "Day", "Swing", the prop firm's name.
  ///
  /// SPEC §3.3 said one MT5 account per user and the column above was `@unique`. A real
  /// client turned up running two FTMO accounts against one strategy each, and a journal that
  /// merges them reports the average of two strategies, which describes neither. Null for an
  /// account connected before there was anything to call it.
  label String?

  /// What this account is *for*, and therefore what its trades are.
  ///
  /// The trader runs one account for swings and one for day trades — that is the reason there
  /// are two, not a note about them. So it decides the style of everything the account
  /// imports, overriding the calendar rule in `styleOf`: a swing closed inside one session is
  /// still a swing to the person who took it, and labelling it `day` because the clock says so
  /// contradicts the account it came from and splits one strategy across both breakdowns.
  ///
  /// Null for an account connected without saying, which keeps the calendar rule — the only
  /// evidence there is when nobody has told us anything.
  purpose TradeStyle?

  /// AES-256-GCM ciphertext of the **investor (read-only)** password, encoded as
  /// iv:authTag:ciphertext in base64. Never logged, never sent to the client, and never
  /// returned by a repository — only src/lib/mt5 decrypts it.
  investorPwEncrypted String @map("investor_pw_encrypted")

  status     Mt5Status @default(pending)
  lastSyncAt DateTime? @map("last_sync_at")

  /// Account state from the last successful sync, in the account's own currency.
  accountCurrency String?  @map("account_currency")
  balance         Decimal? @db.Decimal(20, 8)
  equity          Decimal? @db.Decimal(20, 8)

  /// Provider-side identifier (e.g. the MetaApi account id) when the provider keeps its
  /// own record of the connection.
  providerAccountId String? @map("provider_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  /// One registration per broker account, rather than one per user. The same login at two
  /// brokers is two accounts; the same login twice at one broker is the same account.
  @@unique([userId, login, server])
  @@map("mt5_accounts")
}

// ---------------------------------------------------------------------------
// Trades
// ---------------------------------------------------------------------------

/**
 * What the broker said the account was worth, each time it was asked.
 * `mt5_accounts` carries `balance` and `equity` as two columns that the sync overwrites, so
 * the product knew what the account is worth now and had no way to say what it was worth in
 * March. The equity curve on the dashboard is built from the *trades* instead — which is the
 * right curve for judging trading, and deliberately excludes deposits and withdrawals — but
 * it means nothing in the product ever showed the account's actual balance over time, and a
 * trader asking "what was I at in March" had nowhere to look.
 * One row per sync, deduplicated to one per day by `@@unique`: a trader who signs in six
 * times on Tuesday wants one point for Tuesday, not six, and the sync is the only writer so
 * the upsert cannot race with anything but itself.
 * `equity` is nullable because it is a live figure — balance plus open profit — and a
 * provider that reports only the settled balance should leave a gap rather than a number
 * that looks like a flat day.
 */
model AccountSnapshot {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// Midnight of the day, in UTC, so one row per calendar day is enforceable by the index.
  /// The precise instant of the sync is `createdAt`.
  at DateTime

  balance  Decimal  @db.Decimal(20, 8)
  equity   Decimal? @db.Decimal(20, 8)
  /// The account's own currency at the time. Kept per row: a trader who changes broker
  /// account mid-history would otherwise have two currencies on one chart with no way to see
  /// it happened.
  currency String

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, at])
  @@index([userId, at])
  @@map("account_snapshots")
}

enum AssetClass {
  forex
  crypto
  indices
  stocks
  /// SPEC §3.5 lists סחורות (commodities) as a dimension; the prototype folded gold into
  /// forex. Classified from the symbol by src/lib/mt5/symbols.ts.
  commodities
  other
}

enum Direction {
  long
  short
}

enum TradeStyle {
  day
  swing
}

/// When the exit happened relative to the plan. Deliberately three answers rather than a
/// boolean: "early" and "late" are different mistakes with different fixes, and collapsing
/// them into "not on time" would hide which one a trader keeps making.
enum TpTiming {
  early
  onTime
  late
}

enum DealKind {
  /// A real market position. Only these feed the analytics engine.
  trade
  /// Deposit or withdrawal (SPEC §3.2). Stored so the balance view can show cash flow,
  /// excluded from every performance metric.
  balance
  credit
  correction
}

model Trade {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// MT5 position/deal ticket. Kept as text: tickets are 64-bit and we never do arithmetic
  /// on them. Together with user_id this is the idempotency key for sync.
  ticket String

  kind DealKind @default(trade)

  symbol     String
  assetClass AssetClass @map("asset_class")
  direction  Direction
  style      TradeStyle

  openAt  DateTime  @map("open_at")
  closeAt DateTime? @map("close_at")

  volume     Decimal  @db.Decimal(20, 8)
  entryPrice Decimal  @map("entry_price") @db.Decimal(20, 8)
  exitPrice  Decimal? @map("exit_price") @db.Decimal(20, 8)
  sl         Decimal? @db.Decimal(20, 8)
  tp         Decimal? @db.Decimal(20, 8)

  commission Decimal @default(0) @db.Decimal(20, 8)
  swap       Decimal @default(0) @db.Decimal(20, 8)
  /// Net result in the account currency, commission and swap already included.
  profit     Decimal @db.Decimal(20, 8)

  /// risk = |entry_price − sl| × contractValue(symbol) × volume, in account currency.
  /// NULL when the trade carried no stop loss or the symbol's contract spec is unknown.
  risk Decimal? @db.Decimal(20, 8)
  /// rr = profit / risk. NULL exactly when `risk` is NULL — such trades are excluded
  /// from every RR aggregate and counted against RR coverage instead.
  rr   Decimal? @db.Decimal(20, 8)

  /// Maximum adverse excursion: the furthest the position went *against* the entry before it
  /// closed, in the account currency, as a positive number. Answers "was my stop too tight" —
  /// a book of winners whose MAE never came near the stop is a book paying for protection it
  /// does not use, and one where the stop was grazed on every winner is one trade away from
  /// giving them all back.
  mae Decimal? @db.Decimal(20, 8)
  /// Maximum favourable excursion: the furthest it went *for* the entry. Answers "how much
  /// did I leave on the table" — the gap between MFE and the realised exit is the cost of
  /// every early close, and it is the number that decides whether a trailing stop would help.
  ///
  /// Both are NULL when the price history behind them could not be had: a provider that does
  /// not supply candles, a symbol with no contract spec, a currency that cannot be converted.
  /// Null means unknown, and is excluded from the aggregates rather than counted as zero —
  /// the same rule `risk` and `rr` already follow.
  mfe Decimal? @db.Decimal(20, 8)

  /// Per-trade journal (SPEC §1.1, adopted from tradeReport). Columns land in P1 so no
  /// migration is needed later; the editing UI is milestone 1.9.
  note     String?
  tags     String[] @default([])
  rating   Int?
  mood     String?
  strategy String?

  /// How the exit compared to the plan's timing. NULL means unanswered, which is different
  /// from any of the three answers and is why this is nullable rather than defaulted.
  tpTiming       TpTiming? @map("tp_timing")
  /// Whether the trade was closed at the take-profit that was set when it was opened.
  /// NULL means unanswered.
  tookOriginalTp Boolean?  @map("took_original_tp")

  /// Null for a manual trade. See the note on the unique index below.
  mt5AccountId String? @map("mt5_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mt5Account Mt5Account? @relation(fields: [mt5AccountId], references: [id], onDelete: SetNull)

  /// Which broker account this came from, and null for a trade the trader typed.
  ///
  /// Without it two connected accounts share one book and every metric is the average of two
  /// strategies. `SetNull` rather than `Cascade`: disconnecting a broker deliberately keeps
  /// the trades — they are the trader's journal, not the broker's — so they lose the link
  /// rather than the history.
  ///
  /// **The unique index over this column is `NULLS NOT DISTINCT`,** which Prisma cannot
  /// express and the migration writes by hand. Without it Postgres treats every null as its
  /// own value, and the manual trades — all of which have a null account — would stop
  /// colliding with each other, silently undoing the idempotency in `createManualTrade`.
  @@unique([userId, mt5AccountId, ticket])
  @@index([userId, mt5AccountId])
  @@index([userId, closeAt])
  @@index([userId, kind])
  @@index([userId, kind, closeAt])
  @@index([userId, assetClass])
  @@index([userId, direction])
  @@index([userId, style])
  /// Both are `where` predicates on the trades table — the strategy dropdown and the tag
  /// filter — and both were scanning. `tags` is an array column, so it takes a GIN index;
  /// btree cannot answer `has`.
  @@index([userId, strategy])
  @@index([tags], type: Gin)
  @@map("trades")
}

// ---------------------------------------------------------------------------
// Personal finance
// ---------------------------------------------------------------------------

enum FinanceType {
  income
  expense
}

/// A monthly ceiling for one category of spending, for one brother.
///
/// The ledger already answers "what did I spend"; this is what turns that into "how much is
/// left". Per calendar month, because that is the unit an allowance is decided in — the
/// screen scales it to whatever window is being read rather than storing a second figure.
///
/// Per brother for the same reason `FinanceEntry.owner` is: their money is separate, and a
/// shared ceiling on separate spending is a number neither of them agreed to.
model Budget {
  id String @id @default(cuid())

  userId String @map("user_id")
  /// One of the names in `src/lib/household.ts`. Never null — unlike a ledger row, a budget
  /// with no owner belongs to nobody and would be drawn on both brothers' screens.
  owner  String

  /// Free text, exactly like `FinanceEntry.category`, so a budget can be set on whatever the
  /// trader actually writes down rather than on a list somebody else chose.
  category String

  /// A month's ceiling, in `currency` — not in shekels. The one figure on this screen that
  /// is stored as it was typed: a ceiling converted into shekels at the moment it was set
  /// would drift every time the rate moved, so "$2,000 a month" would quietly become $1,935.
  amount Decimal @db.Decimal(14, 2)

  /// What that figure is denominated in. One of `SUPPORTED_CURRENCIES`; shekels unless the
  /// person said otherwise. Per budget rather than per person, because the header's display
  /// currency is a way of *reading* the book and this is a decision about the money itself —
  /// switching the header to dollars must not change what was budgeted.
  currency String @default("ILS")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One ceiling per category per brother. Setting the same one again is an edit, not a
  /// second row that silently doubles the allowance.
  @@unique([userId, owner, category])
  @@index([userId, owner])
  @@map("budgets")
}

model FinanceEntry {
  id String @id @default(cuid())

  userId String @map("user_id")

  type     FinanceType
  category String      @default("other")
  label    String

  /// Which brother this money belongs to.
  ///
  /// The login is shared by two brothers whose trading is genuinely joint — but money is not:
  /// each has his own income and expenses, and a budget that merges them answers a question
  /// neither asked. One of the names in `src/lib/household.ts`. Null means the row predates
  /// the split or was deliberately entered as shared; it shows only under "both".
  owner String?

  /// Personal finance is ILS-native (SPEC §3.1); display conversion happens at render time.
  amountIls Decimal @map("amount_ils") @db.Decimal(14, 2)

  entryDate DateTime @map("entry_date") @db.Date

  isRecurring    Boolean   @default(false) @map("is_recurring")
  /// Optional end of a recurring series; NULL means "until removed".
  recurringUntil DateTime? @map("recurring_until") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryDate])
  @@index([userId, type])
  @@map("finance_entries")
}

// ---------------------------------------------------------------------------
// Manual long-term positions
// ---------------------------------------------------------------------------

model LongPosition {
  id String @id @default(cuid())

  userId String @map("user_id")

  symbol String
  qty    Decimal @db.Decimal(20, 8)

  buyPrice Decimal  @map("buy_price") @db.Decimal(20, 8)
  buyDate  DateTime @map("buy_date") @db.Date

  /// Latest **per-unit** price. Entered by hand, or written by the quote refresh when the
  /// position is tracked (see `priceSource`).
  /// The brief calls this `current_value`; it is stored per unit rather than as a position
  /// total because that is what the prototype's update field takes and what the user reads
  /// off their broker. Position value is `currentPrice × qty`.
  currentPrice   Decimal  @map("current_price") @db.Decimal(20, 8)
  valueUpdatedAt DateTime @map("value_updated_at")

  /// `auto` — the refresh writes `currentPrice` from the quote feed.
  /// `manual` — the user owns the price and nothing overwrites it. The default, because a
  /// position whose symbol the feed does not carry must keep working exactly as before.
  /// Typing a price by hand always drops a position back to `manual`: the user correcting a
  /// number and the feed overwriting it a minute later is the one outcome nobody wants.
  priceSource String @default("manual") @map("price_source")

  /// Market Identifier Code of the listing this position tracks (`XNGS` for Apple on
  /// NASDAQ). Load-bearing rather than decorative: `AAPL` is listed on six exchanges in four
  /// currencies, so the symbol alone does not identify a price. Empty for crypto pairs.
  micCode String @default("") @map("mic_code")

  fees Decimal @default(0) @db.Decimal(20, 8)

  /// Currency the position is priced in.
  currency String @default("USD")

  realizedPnl Decimal?  @map("realized_pnl") @db.Decimal(20, 8)
  closedAt    DateTime? @map("closed_at")

  /// The same journal the synced trades carry, and the same columns by name.
  ///
  /// A position held for months is the one a trader has most to say about — the thesis it was
  /// opened on, whether they added to it, why they are still in it — and until now the only
  /// place to write any of that was a single unlabelled `note` with no way to file it. The
  /// reason for holding remains the reason for holding whether the broker reported the fill
  /// or the trader typed it, so the analytics group them by the same strategy and the same
  /// tag rather than by two vocabularies that happen to look alike.
  note     String?
  tags     String[] @default([])
  rating   Int?
  mood     String?
  strategy String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, closedAt])
  @@index([priceSource, closedAt])
  @@map("long_positions")
}

/// A study session: what was learned, for how long, and which half it belongs to.
///
/// A sibling of `FinanceEntry` rather than of `Trade` — it is a ledger the trader keeps by
/// hand, not something the broker reports, so nothing syncs into it and nothing overwrites it.
model LearningEntry {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// What the session was about, in the trader's own words.
  ///
  /// A free string rather than the two-value enum it started as. The pair it shipped with —
  /// psychology and technical — are still the defaults and still carry their own labels and
  /// colours, but a trader who spends an evening back-testing has no way to say so, and the
  /// answer cannot be "ask for a migration each time". The screens group on a folded key, so
  /// "Back test", "back test" and "Backtest " are one topic however carefully anyone types.
  topic String
  /// What was learned, in the trader's own words.
  title String
  note  String?

  /// Who did the studying.
  ///
  /// One login, two people: the account belongs to a pair who study the same craft, and
  /// "we did eleven hours" answers nothing about whether one of them did ten of them. Kept as
  /// a name rather than a second user row, because these two share one book by design and
  /// splitting the login would split the trades with it.
  ///
  /// Null for a session recorded before anyone was named, which is not the same as a session
  /// nobody did — it groups under its own heading rather than being assigned to whoever is
  /// alphabetically first.
  learner String?

  /// Session length. Two decimals so a 45-minute session is 0.75 rather than a rounded hour;
  /// the analytics pie is weighted by this, since ten minutes and an afternoon are not the
  /// same amount of study.
  /// Stored in hours, but entered and read in hours *and minutes*.
  ///
  /// Four decimal places rather than two, and the difference is not academic: a whole number
  /// of minutes is almost never a clean hundredth of an hour — 35 minutes is 0.58333… — so at
  /// two places every entry is stored slightly wrong and the error accumulates across the
  /// ledger. Measured: forty sessions of 35 minutes came back as 1,392 minutes instead of
  /// 1,400. At four places the same forty round-trip exactly.
  hours Decimal @db.Decimal(8, 4)

  learnedOn DateTime @map("learned_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, learnedOn])
  @@map("learning_entries")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum SyncStatus {
  running
  success
  error
}

enum SyncTrigger {
  login
  manual
  admin
  backfill
}

model SyncLog {
  id String @id @default(cuid())

  userId String @map("user_id")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  status  SyncStatus  @default(running)
  trigger SyncTrigger @default(login)

  tradesImported Int @default(0) @map("trades_imported")
  tradesUpdated  Int @default(0) @map("trades_updated")

  /// Operator-facing failure reason. Must never contain credentials.
  error String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("sync_logs")
}

model FxRate {
  id String @id @default(cuid())

  base  String
  quote String
  rate  Decimal @db.Decimal(20, 10)

  /// The rate's own date, as published. Daily granularity is enough (SPEC §3.1).
  asOf      DateTime @map("as_of") @db.Date
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([base, quote, asOf])
  @@index([base, quote, asOf])
  @@map("fx_rates")
}

/// The market-price cache.
///
/// Shared, not tenant data — Apple closed at one price for everybody — and that sharing is
/// the point: two positions in the same symbol cost one API credit between them, whoever
/// holds them. Keyed by (symbol, micCode) for the same reason the column exists on
/// `LongPosition`: one ticker, several listings, different currencies.
model Quote {
  id String @id @default(cuid())

  symbol  String
  /// Empty for crypto pairs, which are not listed on an exchange.
  micCode String @map("mic_code")

  /// Null when the provider had nothing for this listing. The row still exists, because it
  /// carries `fetchedAt`: without it a ticker the vendor does not carry has nothing to stamp
  /// and is retried on every single tick, forever. Nullable rather than zero so that a
  /// missing price can never be read as a price of nothing.
  price    Decimal? @db.Decimal(20, 8)
  /// The currency the *quote* is in. A position priced in another one is left alone rather
  /// than silently marked to market at the wrong scale.
  currency String?

  /// When the market produced this price — the close it came from, not when we asked. This
  /// is what decides whether a refresh is owed.
  asOf      DateTime? @map("as_of")
  /// When we last asked. Separate from `asOf` so a feed that keeps returning the same close
  /// (a holiday, a delisting) cannot put the refresh into a loop.
  fetchedAt DateTime  @default(now()) @map("fetched_at")

  @@unique([symbol, micCode])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Compliance & Consent Management (GDPR)
// ---------------------------------------------------------------------------

/// User consent tracking for GDPR compliance
/// Tracks user consent for data processing, marketing, analytics, and cookies
/// All consent changes are logged for audit trail
model UserConsent {
  id String @id @default(cuid())

  /// User who gave consent
  userId String @map("user_id")

  /// Consent type: gdpr_processing, marketing_email, analytics_cookies, preference_cookies, essential_cookies, terms_of_service, privacy_policy
  type String

  /// Whether consent was granted (true) or revoked (false)
  granted Boolean

  /// When consent was granted/revoked
  grantedAt DateTime @default(now()) @map("granted_at")

  /// When this consent record expires (typically 1 year from grantedAt)
  expiresAt DateTime? @map("expires_at")

  /// IP address of the user when consent was given (for audit trail)
  ipAddress String? @map("ip_address")

  /// User agent string (browser/app identifier)
  userAgent String? @map("user_agent")

  /// Source of consent: banner, settings, implicit, api
  source String @default("api")

  /// Optional notes (e.g., "Accepted v1.0", "Revoked via settings")
  notes String?

  /// Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([grantedAt])
  @@index([expiresAt])
  @@map("user_consents")
}

// ---------------------------------------------------------------------------
// Audit Logging (Security & Compliance)
// ---------------------------------------------------------------------------

/// Authentication events: successful/failed logins, password changes, sessions
model AuthEvent {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// Event type: login_success, login_failed, password_changed, session_created, etc.
  eventType String @map("event_type")

  /// User-facing action description
  description String

  /// IP address that triggered the event (from X-Forwarded-For)
  ipAddress String? @map("ip_address")

  /// User agent string (browser/app identifier)
  userAgent String? @map("user_agent")

  /// Result: success, failure, blocked (rate limited), etc.
  result String @default("success")

  /// Additional context (e.g., failed login reason: "wrong_password", "account_locked")
  details Json? @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("auth_events")
}

/// Admin action audit log: who did what, when, for compliance
model AdminAuditLog {
  id String @id @default(cuid())

  /// Who performed the action (super admin ID)
  adminId String? @map("admin_id")

  /// Which tenant/user was affected (optional, null for system actions)
  tenantId String? @map("tenant_id")
  userId   String? @map("user_id")

  /// Action type: create_tenant, suspend_tenant, create_user, reset_password, etc.
  actionType String @map("action_type")

  /// Human-readable description
  description String

  /// Changes made (JSON object with old/new values)
  changes Json?

  /// IP address of the admin
  ipAddress String? @map("ip_address")

  /// User agent (browser/app)
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([tenantId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Data access log: who accessed what data, when (for GDPR compliance)
model DataAccessLog {
  id String @id @default(cuid())

  /// User who accessed the data
  userId String @map("user_id")

  /// Action: export, access, list, download, etc.
  action String

  /// Resource accessed: user_profile, trades, finance_entries, etc.
  resource String

  /// Number of records accessed/exported
  recordCount Int? @map("record_count")

  /// Size of data in bytes (for exports)
  dataSizeBytes Int? @map("data_size_bytes")

  /// IP address
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("data_access_logs")
}

/// Fixed-window counters for login, password reset and sync. Kept in the database rather
/// than in memory so the limit still holds when the app runs more than one instance.
model RateLimit {
  id String @id @default(cuid())

  /// "<bucket>:<subject>", e.g. "login:demo.tri.app|user@example.com".
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Database Audit Logging (Production Compliance & Security)
// ---------------------------------------------------------------------------

/// Comprehensive database operation audit log
/// Captures: table, operation (INSERT/UPDATE/DELETE), old/new values, user, timestamp
/// Retention: 12 months (auto-archived to S3 after 90 days)
/// Used for: compliance, forensics, detecting data tampering
model DatabaseAuditLog {
  id String @id @default(cuid())

  /// Table being audited: users, trades, mt5_accounts, sessions, etc.
  tableName String @map("table_name")

  /// Operation type: INSERT, UPDATE, DELETE
  operation String

  /// Primary key of the affected row
  recordId String @map("record_id")

  /// For UPDATE operations: previous values (JSON)
  /// For DELETE operations: complete row (JSON)
  oldValues Json? @map("old_values")

  /// For INSERT/UPDATE operations: new values (JSON)
  newValues Json? @map("new_values")

  /// User who triggered the operation (from session/context)
  userId String? @map("user_id")

  /// Tenant that owned the record (for multi-tenancy audit)
  tenantId String? @map("tenant_id")

  /// IP address that triggered the operation
  ipAddress String? @map("ip_address")

  /// User agent (browser/client)
  userAgent String? @map("user_agent")

  /// Query execution time in milliseconds
  executionTimeMs Int? @map("execution_time_ms")

  /// Whether this operation was flagged as suspicious
  suspicious Boolean @default(false)

  /// Reason if flagged: "large_result_set", "slow_query", "bulk_delete", etc.
  suspicionReason String? @map("suspicion_reason")

  /// Timestamp of the operation
  createdAt DateTime @default(now()) @map("created_at")

  /// Whether this has been archived to cold storage (S3)
  archived Boolean @default(false)

  /// S3 path if archived
  archivePath String? @map("archive_path") @db.VarChar(500)

  @@index([tableName])
  @@index([operation])
  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([archived, createdAt])
  @@index([suspicious])
  @@map("database_audit_logs")
}

/// Audit log for data changes (detailed change tracking)
/// Used to answer: "What changed? When? Who changed it? Old vs new value?"
model DataChangeLog {
  id String @id @default(cuid())

  /// Reference to the database audit log entry
  auditLogId String? @map("audit_log_id")

  /// Table being audited
  tableName String @map("table_name")

  /// Operation type
  operation String

  /// Primary key of affected row
  recordId String @map("record_id")

  /// Column name that changed (for UPDATE operations)
  columnName String? @map("column_name")

  /// Previous value (stringified)
  oldValue String? @map("old_value") @db.Text

  /// New value (stringified)
  newValue String? @map("new_value") @db.Text

  /// Whether this is a sensitive field (password, token, key)
  sensitive Boolean @default(false)

  /// User who made the change
  userId String? @map("user_id")

  /// Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([auditLogId])
  @@index([tableName])
  @@index([recordId])
  @@index([userId])
  @@index([createdAt])
  @@map("data_change_logs")
}

/// Audit log for schema changes (structure modifications)
model SchemaAuditLog {
  id String @id @default(cuid())

  /// DDL statement executed (ALTER TABLE, CREATE INDEX, etc.)
  statement String @db.Text

  /// User who executed the change (admin)
  adminId String? @map("admin_id")

  /// Result: success or error message
  result String

  /// Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([createdAt])
  @@map("schema_audit_logs")
}
