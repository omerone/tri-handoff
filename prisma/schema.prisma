// TRi — data model
//
// Multi-tenancy: one row in `tenants` per paying client, one `users` row per tenant
// (SPEC §2: "משתמש יחיד בכל דומיין"). Every row that carries user data hangs off `users`,
// which is why `user_id` is the scoping key on the leaf tables and `tenant_id` is unique
// on `users`. The repositories in src/lib/db resolve tenant → user once and then scope
// every query by `user_id`; nothing outside that directory is allowed to touch Prisma.
//
// Money and prices are `Decimal` in the database so nothing is lost on the way in. The
// repositories convert to `number` at the boundary, because the analytics engine is pure
// arithmetic over JS numbers and the magnitudes involved (retail trading account P&L) are
// far inside the safe-integer range.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  /// Fully-qualified host, lowercased, no scheme and no trailing dot.
  /// The middleware matches the incoming Host header against this exactly.
  domain    String       @unique
  status    TenantStatus @default(active)
  notes     String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User?

  @@index([status])
  @@map("tenants")
}

enum Locale {
  he
  en
}

/// SPEC §1.1 asks for a light mode alongside the dark default. `system` follows the
/// operating system, which is resolved in CSS rather than JavaScript so there is no flash
/// of the wrong theme on first paint.
enum Theme {
  dark
  light
  system
}

model User {
  id       String @id @default(cuid())
  /// Unique: one trader per tenant domain.
  tenantId String @unique @map("tenant_id")

  email           String
  passwordHash    String @map("password_hash")
  locale          Locale @default(he)
  /// ISO-4217 code the UI renders figures in. Trading data arrives in the MT5 account
  /// currency and finance data in ILS; both are converted for display.
  displayCurrency String @default("ILS") @map("display_currency")
  theme           Theme  @default(dark)
  /// The dashboard arrangement the user built (SPEC §1.1). An ordered `[{id, span}]` list;
  /// null means "never touched it, use the default". Read through `normalizeLayout`, which
  /// tolerates any shape — this column outlives the code that wrote it.
  dashboardLayout Json?  @map("dashboard_layout")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  mt5Account     Mt5Account?
  trades         Trade[]
  financeEntries FinanceEntry[]
  longPositions  LongPosition[]
  syncLogs       SyncLog[]

  @@unique([tenantId, email])
  @@map("users")
}

model Session {
  id String @id @default(cuid())

  userId     String   @map("user_id")
  /// SHA-256 of the cookie value. The raw token never touches the database, so a dump
  /// of this table cannot be replayed as a login.
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions SuperAdminSession[]

  @@map("super_admins")
}

model SuperAdminSession {
  id String @id @default(cuid())

  superAdminId String   @map("super_admin_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@map("super_admin_sessions")
}

// ---------------------------------------------------------------------------
// MT5
// ---------------------------------------------------------------------------

enum Mt5Status {
  /// Credentials stored, never successfully verified yet.
  pending
  connected
  /// Last sync failed; see the newest SyncLog row for the reason.
  error
  disconnected
}

model Mt5Account {
  id String @id @default(cuid())

  /// Unique: SPEC §3.3 — exactly one MT5 account per user.
  userId String @unique @map("user_id")

  login  String
  server String

  /// AES-256-GCM ciphertext of the **investor (read-only)** password, encoded as
  /// iv:authTag:ciphertext in base64. Never logged, never sent to the client, and never
  /// returned by a repository — only src/lib/mt5 decrypts it.
  investorPwEncrypted String @map("investor_pw_encrypted")

  status     Mt5Status @default(pending)
  lastSyncAt DateTime? @map("last_sync_at")

  /// Account state from the last successful sync, in the account's own currency.
  accountCurrency String?  @map("account_currency")
  balance         Decimal? @db.Decimal(20, 8)
  equity          Decimal? @db.Decimal(20, 8)

  /// Provider-side identifier (e.g. the MetaApi account id) when the provider keeps its
  /// own record of the connection.
  providerAccountId String? @map("provider_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mt5_accounts")
}

// ---------------------------------------------------------------------------
// Trades
// ---------------------------------------------------------------------------

enum AssetClass {
  forex
  crypto
  indices
  stocks
  /// SPEC §3.5 lists סחורות (commodities) as a dimension; the prototype folded gold into
  /// forex. Classified from the symbol by src/lib/mt5/symbols.ts.
  commodities
  other
}

enum Direction {
  long
  short
}

enum TradeStyle {
  day
  swing
}

enum DealKind {
  /// A real market position. Only these feed the analytics engine.
  trade
  /// Deposit or withdrawal (SPEC §3.2). Stored so the balance view can show cash flow,
  /// excluded from every performance metric.
  balance
  credit
  correction
}

model Trade {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// MT5 position/deal ticket. Kept as text: tickets are 64-bit and we never do arithmetic
  /// on them. Together with user_id this is the idempotency key for sync.
  ticket String

  kind DealKind @default(trade)

  symbol     String
  assetClass AssetClass @map("asset_class")
  direction  Direction
  style      TradeStyle

  openAt  DateTime  @map("open_at")
  closeAt DateTime? @map("close_at")

  volume     Decimal  @db.Decimal(20, 8)
  entryPrice Decimal  @map("entry_price") @db.Decimal(20, 8)
  exitPrice  Decimal? @map("exit_price") @db.Decimal(20, 8)
  sl         Decimal? @db.Decimal(20, 8)
  tp         Decimal? @db.Decimal(20, 8)

  commission Decimal @default(0) @db.Decimal(20, 8)
  swap       Decimal @default(0) @db.Decimal(20, 8)
  /// Net result in the account currency, commission and swap already included.
  profit     Decimal @db.Decimal(20, 8)

  /// risk = |entry_price − sl| × contractValue(symbol) × volume, in account currency.
  /// NULL when the trade carried no stop loss or the symbol's contract spec is unknown.
  risk Decimal? @db.Decimal(20, 8)
  /// rr = profit / risk. NULL exactly when `risk` is NULL — such trades are excluded
  /// from every RR aggregate and counted against RR coverage instead.
  rr   Decimal? @db.Decimal(20, 8)

  /// Per-trade journal (SPEC §1.1, adopted from tradeReport). Columns land in P1 so no
  /// migration is needed later; the editing UI is milestone 1.9.
  note     String?
  tags     String[] @default([])
  rating   Int?
  mood     String?
  strategy String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticket])
  @@index([userId, closeAt])
  @@index([userId, kind, closeAt])
  @@index([userId, assetClass])
  @@index([userId, direction])
  @@index([userId, style])
  @@map("trades")
}

// ---------------------------------------------------------------------------
// Personal finance
// ---------------------------------------------------------------------------

enum FinanceType {
  income
  expense
}

model FinanceEntry {
  id String @id @default(cuid())

  userId String @map("user_id")

  type     FinanceType
  category String      @default("other")
  label    String

  /// Personal finance is ILS-native (SPEC §3.1); display conversion happens at render time.
  amountIls Decimal @map("amount_ils") @db.Decimal(14, 2)

  entryDate DateTime @map("entry_date") @db.Date

  isRecurring    Boolean   @default(false) @map("is_recurring")
  /// Optional end of a recurring series; NULL means "until removed".
  recurringUntil DateTime? @map("recurring_until") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryDate])
  @@index([userId, type])
  @@map("finance_entries")
}

// ---------------------------------------------------------------------------
// Manual long-term positions
// ---------------------------------------------------------------------------

model LongPosition {
  id String @id @default(cuid())

  userId String @map("user_id")

  symbol String
  qty    Decimal @db.Decimal(20, 8)

  buyPrice Decimal  @map("buy_price") @db.Decimal(20, 8)
  buyDate  DateTime @map("buy_date") @db.Date

  /// Latest **per-unit** price. Entered by hand, or written by the quote refresh when the
  /// position is tracked (see `priceSource`).
  /// The brief calls this `current_value`; it is stored per unit rather than as a position
  /// total because that is what the prototype's update field takes and what the user reads
  /// off their broker. Position value is `currentPrice × qty`.
  currentPrice   Decimal  @map("current_price") @db.Decimal(20, 8)
  valueUpdatedAt DateTime @map("value_updated_at")

  /// `auto` — the refresh writes `currentPrice` from the quote feed.
  /// `manual` — the user owns the price and nothing overwrites it. The default, because a
  /// position whose symbol the feed does not carry must keep working exactly as before.
  /// Typing a price by hand always drops a position back to `manual`: the user correcting a
  /// number and the feed overwriting it a minute later is the one outcome nobody wants.
  priceSource String @default("manual") @map("price_source")

  /// Market Identifier Code of the listing this position tracks (`XNGS` for Apple on
  /// NASDAQ). Load-bearing rather than decorative: `AAPL` is listed on six exchanges in four
  /// currencies, so the symbol alone does not identify a price. Empty for crypto pairs.
  micCode String @default("") @map("mic_code")

  fees Decimal @default(0) @db.Decimal(20, 8)

  /// Currency the position is priced in.
  currency String @default("USD")

  realizedPnl Decimal?  @map("realized_pnl") @db.Decimal(20, 8)
  closedAt    DateTime? @map("closed_at")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, closedAt])
  @@index([priceSource, closedAt])
  @@map("long_positions")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum SyncStatus {
  running
  success
  error
}

enum SyncTrigger {
  login
  manual
  admin
  backfill
}

model SyncLog {
  id String @id @default(cuid())

  userId String @map("user_id")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  status  SyncStatus  @default(running)
  trigger SyncTrigger @default(login)

  tradesImported Int @default(0) @map("trades_imported")
  tradesUpdated  Int @default(0) @map("trades_updated")

  /// Operator-facing failure reason. Must never contain credentials.
  error String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("sync_logs")
}

model FxRate {
  id String @id @default(cuid())

  base  String
  quote String
  rate  Decimal @db.Decimal(20, 10)

  /// The rate's own date, as published. Daily granularity is enough (SPEC §3.1).
  asOf      DateTime @map("as_of") @db.Date
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([base, quote, asOf])
  @@index([base, quote, asOf])
  @@map("fx_rates")
}

/// The market-price cache.
///
/// Shared, not tenant data — Apple closed at one price for everybody — and that sharing is
/// the point: two positions in the same symbol cost one API credit between them, whoever
/// holds them. Keyed by (symbol, micCode) for the same reason the column exists on
/// `LongPosition`: one ticker, several listings, different currencies.
model Quote {
  id String @id @default(cuid())

  symbol  String
  /// Empty for crypto pairs, which are not listed on an exchange.
  micCode String @map("mic_code")

  /// Null when the provider had nothing for this listing. The row still exists, because it
  /// carries `fetchedAt`: without it a ticker the vendor does not carry has nothing to stamp
  /// and is retried on every single tick, forever. Nullable rather than zero so that a
  /// missing price can never be read as a price of nothing.
  price    Decimal? @db.Decimal(20, 8)
  /// The currency the *quote* is in. A position priced in another one is left alone rather
  /// than silently marked to market at the wrong scale.
  currency String?

  /// When the market produced this price — the close it came from, not when we asked. This
  /// is what decides whether a refresh is owed.
  asOf DateTime? @map("as_of")
  /// When we last asked. Separate from `asOf` so a feed that keeps returning the same close
  /// (a holiday, a delisting) cannot put the refresh into a loop.
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([symbol, micCode])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Compliance & Consent Management (GDPR)
// ---------------------------------------------------------------------------

/// User consent tracking for GDPR compliance
/// Tracks user consent for data processing, marketing, analytics, and cookies
/// All consent changes are logged for audit trail
model UserConsent {
  id String @id @default(cuid())

  /// User who gave consent
  userId String @map("user_id")

  /// Consent type: gdpr_processing, marketing_email, analytics_cookies, preference_cookies, essential_cookies, terms_of_service, privacy_policy
  type String

  /// Whether consent was granted (true) or revoked (false)
  granted Boolean

  /// When consent was granted/revoked
  grantedAt DateTime @default(now()) @map("granted_at")

  /// When this consent record expires (typically 1 year from grantedAt)
  expiresAt DateTime? @map("expires_at")

  /// IP address of the user when consent was given (for audit trail)
  ipAddress String? @map("ip_address")

  /// User agent string (browser/app identifier)
  userAgent String? @map("user_agent")

  /// Source of consent: banner, settings, implicit, api
  source String @default("api")

  /// Optional notes (e.g., "Accepted v1.0", "Revoked via settings")
  notes String?

  /// Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([grantedAt])
  @@index([expiresAt])
  @@map("user_consents")
}

// ---------------------------------------------------------------------------
// Audit Logging (Security & Compliance)
// ---------------------------------------------------------------------------

/// Authentication events: successful/failed logins, password changes, sessions
model AuthEvent {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// Event type: login_success, login_failed, password_changed, session_created, etc.
  eventType String @map("event_type")

  /// User-facing action description
  description String

  /// IP address that triggered the event (from X-Forwarded-For)
  ipAddress String? @map("ip_address")

  /// User agent string (browser/app identifier)
  userAgent String? @map("user_agent")

  /// Result: success, failure, blocked (rate limited), etc.
  result String @default("success")

  /// Additional context (e.g., failed login reason: "wrong_password", "account_locked")
  details Json? @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("auth_events")
}

/// Admin action audit log: who did what, when, for compliance
model AdminAuditLog {
  id String @id @default(cuid())

  /// Who performed the action (super admin ID)
  adminId String? @map("admin_id")

  /// Which tenant/user was affected (optional, null for system actions)
  tenantId String? @map("tenant_id")
  userId String? @map("user_id")

  /// Action type: create_tenant, suspend_tenant, create_user, reset_password, etc.
  actionType String @map("action_type")

  /// Human-readable description
  description String

  /// Changes made (JSON object with old/new values)
  changes Json?

  /// IP address of the admin
  ipAddress String? @map("ip_address")

  /// User agent (browser/app)
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([tenantId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Data access log: who accessed what data, when (for GDPR compliance)
model DataAccessLog {
  id String @id @default(cuid())

  /// User who accessed the data
  userId String @map("user_id")

  /// Action: export, access, list, download, etc.
  action String

  /// Resource accessed: user_profile, trades, finance_entries, etc.
  resource String

  /// Number of records accessed/exported
  recordCount Int? @map("record_count")

  /// Size of data in bytes (for exports)
  dataSizeBytes Int? @map("data_size_bytes")

  /// IP address
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("data_access_logs")
}

/// Fixed-window counters for login, password reset and sync. Kept in the database rather
/// than in memory so the limit still holds when the app runs more than one instance.
model RateLimit {
  id String @id @default(cuid())

  /// "<bucket>:<subject>", e.g. "login:demo.tri.app|user@example.com".
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Database Audit Logging (Production Compliance & Security)
// ---------------------------------------------------------------------------

/// Comprehensive database operation audit log
/// Captures: table, operation (INSERT/UPDATE/DELETE), old/new values, user, timestamp
/// Retention: 12 months (auto-archived to S3 after 90 days)
/// Used for: compliance, forensics, detecting data tampering
model DatabaseAuditLog {
  id String @id @default(cuid())

  /// Table being audited: users, trades, mt5_accounts, sessions, etc.
  tableName String @map("table_name")

  /// Operation type: INSERT, UPDATE, DELETE
  operation String

  /// Primary key of the affected row
  recordId String @map("record_id")

  /// For UPDATE operations: previous values (JSON)
  /// For DELETE operations: complete row (JSON)
  oldValues Json? @map("old_values")

  /// For INSERT/UPDATE operations: new values (JSON)
  newValues Json? @map("new_values")

  /// User who triggered the operation (from session/context)
  userId String? @map("user_id")

  /// Tenant that owned the record (for multi-tenancy audit)
  tenantId String? @map("tenant_id")

  /// IP address that triggered the operation
  ipAddress String? @map("ip_address")

  /// User agent (browser/client)
  userAgent String? @map("user_agent")

  /// Query execution time in milliseconds
  executionTimeMs Int? @map("execution_time_ms")

  /// Whether this operation was flagged as suspicious
  suspicious Boolean @default(false)

  /// Reason if flagged: "large_result_set", "slow_query", "bulk_delete", etc.
  suspicionReason String? @map("suspicion_reason")

  /// Timestamp of the operation
  createdAt DateTime @default(now()) @map("created_at")

  /// Whether this has been archived to cold storage (S3)
  archived Boolean @default(false)

  /// S3 path if archived
  archivePath String? @map("archive_path") @db.VarChar(500)

  @@index([tableName])
  @@index([operation])
  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([archived, createdAt])
  @@index([suspicious])
  @@map("database_audit_logs")
}

/// Audit log for data changes (detailed change tracking)
/// Used to answer: "What changed? When? Who changed it? Old vs new value?"
model DataChangeLog {
  id String @id @default(cuid())

  /// Reference to the database audit log entry
  auditLogId String? @map("audit_log_id")

  /// Table being audited
  tableName String @map("table_name")

  /// Operation type
  operation String

  /// Primary key of affected row
  recordId String @map("record_id")

  /// Column name that changed (for UPDATE operations)
  columnName String? @map("column_name")

  /// Previous value (stringified)
  oldValue String? @map("old_value") @db.Text

  /// New value (stringified)
  newValue String? @map("new_value") @db.Text

  /// Whether this is a sensitive field (password, token, key)
  sensitive Boolean @default(false)

  /// User who made the change
  userId String? @map("user_id")

  /// Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([auditLogId])
  @@index([tableName])
  @@index([recordId])
  @@index([userId])
  @@index([createdAt])
  @@map("data_change_logs")
}

/// Audit log for schema changes (structure modifications)
model SchemaAuditLog {
  id String @id @default(cuid())

  /// DDL statement executed (ALTER TABLE, CREATE INDEX, etc.)
  statement String @db.Text

  /// User who executed the change (admin)
  adminId String? @map("admin_id")

  /// Result: success or error message
  result String

  /// Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([createdAt])
  @@map("schema_audit_logs")
}
