# ---------------------------------------------------------------------------
# TRi — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. POSTGRES_PASSWORD has no default in docker-compose.yml on purpose —
# a weak default on a database that holds every client is not a risk worth taking.
POSTGRES_PASSWORD="change-me"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://tri:tri@localhost:5432/tri?schema=public"

# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=""

# Exactly 32 bytes, base64 — AES-256-GCM key for the MT5 investor password.
# Generate: openssl rand -base64 32
# Rotating this key makes existing stored MT5 passwords unreadable; users must reconnect.
ENCRYPTION_KEY=""

# MT5 provider: "mock" (deterministic demo data) or "metaapi"
MT5_PROVIDER="mock"
METAAPI_TOKEN=""
METAAPI_REGION="new-york"

# Password-reset email
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TRi <no-reply@example.com>"

# FX rates (daily, cached in DB)
FX_API_URL="https://api.frankfurter.app"

# Base domain used to build tenant URLs in provisioning output and reset links.
APP_BASE_DOMAIN="localhost:3000"
# "http" for local dev, "https" in production.
APP_PROTOCOL="http"
