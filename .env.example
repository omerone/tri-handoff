# ---------------------------------------------------------------------------
# TRi — Environment Configuration
#
# NEVER commit .env with real secrets!
#
# For local development:
#   1. Create .env.local with your secrets (ignored by git)
#   2. Or configure AWS Secrets Manager locally
#   3. Or set environment variables directly
#
# For production:
#   1. Use AWS Secrets Manager (recommended)
#   2. Set secrets via GitHub Actions secrets or deployment platform
#   3. See docs/SECRETS_MANAGEMENT.md for setup instructions
# ---------------------------------------------------------------------------

# === Database (required) ===
# POSTGRES_PASSWORD: No default in docker-compose.yml on purpose — weak defaults
# on a database holding all client data are not acceptable.
POSTGRES_PASSWORD="[CHANGE_ME]"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://tri:tri@localhost:5432/tri?schema=public"
# For Neon (production Vercel): Add pooling to prevent "too many connections"
# Neon Pooler: postgresql://user:password@ep-xxx-pooler.region.postgres.vercel-storage.com/database?sslmode=require
# Connection Pool Limit: &connection_limit=5 (adjust based on concurrency)

# === Encryption & Sessions (CRITICAL — rotate regularly) ===
# Generate via: openssl rand -base64 48
# Minimum 32+ bytes, base64. Never share, never commit to git.
SESSION_SECRET="[GENERATE_WITH: openssl rand -base64 48]"

# Generate via: openssl rand -base64 32
# Must decode to exactly 32 bytes. AES-256-GCM key for encrypting MT5 credentials.
# ⚠️  WARNING: Rotating this key makes existing MT5 passwords unreadable; users must reconnect.
# Use scripts/rotate-secrets.ts for production rotations.
ENCRYPTION_KEY="[GENERATE_WITH: openssl rand -base64 32]"

# === MT5 Broker Integration ===
# "mock" (deterministic demo data) or "metaapi" (requires METAAPI_TOKEN)
MT5_PROVIDER="mock"
# MetaApi token: https://app.metaapi.cloud/
# Only required if MT5_PROVIDER=metaapi
METAAPI_TOKEN=""
# MetaApi region: new-york, london, singapore
METAAPI_REGION="new-york"

# === Email (for password resets, alerts) ===
# Local dev: Use MailPit (included in docker-compose with --profile dev)
# Production: Use a real SMTP provider (SendGrid, AWS SES, etc.)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TRi <no-reply@example.com>"

# === Market Data ===
# FX rates API (daily, cached in DB)
FX_API_URL="https://api.frankfurter.app"

# Market data for long-term positions: "mock" or "twelvedata"
# "mock" is default so no API key is needed during checkout/testing
QUOTES_PROVIDER="mock"
# TwelveData API key: https://twelvedata.com/
# Only required if QUOTES_PROVIDER=twelvedata
TWELVEDATA_API_KEY=""
# Daily credit budget (free plan: 800/day). This is deliberate margin to avoid
# hard stop when hitting vendor limit; running this dry only postpones a refresh.
QUOTES_DAILY_BUDGET="700"

# === App Configuration ===
# Base domain for tenant URLs (used in provisioning output, reset links, etc.)
APP_BASE_DOMAIN="localhost:3000"
# Protocol: "http" for local dev, "https" in production
APP_PROTOCOL="http"

# === Node.js Runtime ===
# NODE_ENV is auto-set to "production" in docker-compose.yml
# NODE_ENV="development"
