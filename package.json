{
  "name": "tri",
  "version": "0.1.0",
  "private": true,
  "_comment:engines": "One version, everywhere: .nvmrc, the Dockerfile base image and CI all say 22. The floor was >=20.9.0, which admitted Node versions the test setup cannot run on — `tests/setup-env.ts` calls process.loadEnvFile, added in 20.12 — so `npm test` failed with a TypeError about a missing function rather than a word about the version. engine-strict in .npmrc turns that into a refusal at install time.",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "prepare": "husky install",
    "_comment:dev": "--turbopack is dev-only and does not touch what `build` produces. Measured on this app: ready in 1.1s rather than 2.1s, and a route compiles in 0.17-0.84s rather than 0.4-2.9s, which is the wait between saving a file and seeing the tab you clicked. Drop the flag if a loader ever misbehaves under it.",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rate-limiting": "vitest run tests/rate-limiting/",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "_comment:tsx": "--conditions=react-server makes the `server-only` guard resolve to its empty stub, so CLI scripts can import the same server modules the app uses. Inlined rather than delegated to a shared script, because nesting `npm run` loses the quoting of forwarded arguments.",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "mt5:verify": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-mt5.ts",
    "myfxbook:verify": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-myfxbook.ts",
    "tenant:create": "NODE_OPTIONS=--conditions=react-server tsx scripts/create-tenant.ts",
    "admin:create": "NODE_OPTIONS=--conditions=react-server tsx scripts/create-super-admin.ts",
    "secrets:rotate": "NODE_OPTIONS=--conditions=react-server tsx scripts/rotate-secrets.ts",
    "audit-logs:archive": "NODE_OPTIONS=--conditions=react-server tsx scripts/archive-audit-logs.ts",
    "audit-logs:archive:dry": "NODE_OPTIONS=--conditions=react-server tsx scripts/archive-audit-logs.ts --dry-run",
    "pgaudit:setup": "bash scripts/setup-pgaudit.sh",
    "waf:setup:cloudflare": "NODE_OPTIONS=--conditions=react-server tsx scripts/setup-cloudflare-waf.ts",
    "waf:setup:aws": "NODE_OPTIONS=--conditions=react-server tsx scripts/setup-aws-waf.ts",
    "waf:deploy": "NODE_OPTIONS=--conditions=react-server tsx scripts/deploy-waf.ts --provider cloudflare --environment log-only",
    "waf:deploy:challenge": "NODE_OPTIONS=--conditions=react-server tsx scripts/deploy-waf.ts --provider cloudflare --environment challenge",
    "waf:deploy:block": "NODE_OPTIONS=--conditions=react-server tsx scripts/deploy-waf.ts --provider cloudflare --environment block",
    "waf:test": "vitest run tests/waf/",
    "waf:dry-run": "NODE_OPTIONS=--conditions=react-server tsx scripts/deploy-waf.ts --provider cloudflare --environment log-only --dry-run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.469.0",
    "next": "^15.2.3",
    "next-intl": "^3.26.3",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "zod": "^3.24.1",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.2.3",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
